---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	aprilFools?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/blog-placeholder-1.jpg', aprilFools } = Astro.props;
---

<!-- Credits -->
<!-- Website orignally made with <3 by Luna '26 @itsactuallyluna9 -->
<!-- Special Thanks: James Belding '26, Eliza Carlson '25, Murray Page '27 -->

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Marks April 1 articles so the April Fools theme can be scoped per page. Head tags are
	replaced on client-side navigation, unlike the <html> element, which persists. -->
{aprilFools && <meta name="april-fools" content="true" />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Fancy Page Transitions -->
<ClientRouter />

<script is:inline>
	// The Cornhellian theme is active when today is April 1, or when the current page
	// is an April 1 article (marked with the `april-fools` meta tag). The <html>
	// element and this script's listeners survive client-side navigations, so the
	// class must be toggled on every page load instead of only added.
	function isTodayAprilFools() {
		var d = new Date();
		return d.getMonth() === 3 && d.getDate() === 1;
	}
	function applyAprilFools() {
		var onAprilArticle = document.querySelector('meta[name="april-fools"]') !== null;
		var active = isTodayAprilFools() || onAprilArticle;
		document.documentElement.classList.toggle('april-fools', active);
		if (!active) return;
		var titleEl = document.getElementById('header_title');
		if (titleEl) titleEl.textContent = 'The Cornhellian';
		var subtitleEl = document.getElementById('subtitle');
		if (subtitleEl) subtitleEl.textContent = 'Truth With Fear. Since the 1800s.';
	}
	applyAprilFools();
	document.addEventListener('astro:page-load', applyAprilFools);
</script>
