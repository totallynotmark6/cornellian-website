---
// Shows a random banner ad (April Fools only)
// 728x90
const ads = [
    { src: '/ads/niko.png', link: '' },
    { src: '/ads/know-not.png', link: 'https://www.cornellcollege.edu/ingenuity/index.shtml' },
    { src: '/ads/hot-squirrels.png', link: '' },
    { src: '/ads/pumpkin.png', link: '' },
    { src: '/ads/lighting_design_1.png', link: 'https://selfservice.cornellcollege.edu/PowerCampusSelfService/Search/Section/Share?&keywords=Lighting%20Design&session=BLOCK8&department=THE' },
];

const randomAd = ads[Math.floor(Math.random() * ads.length)];
---
<div class="mx-auto w-full font-mono text-white mt-2 mb-8 not-prose hidden" id="april-ad">
    <div class="mx-auto relative border-2 border-gray-500 border-ridge bg-black">
        <a href={randomAd.link} class="block w-full h-full">
            <img src={randomAd.src} alt="ad" width="728" height="90" class="w-full h-full" />
        </a>
        <div class="absolute right-0 bottom-0 border-t border-l border-purple-200 p-1 text-sm backdrop-blur-3xl backdrop-grayscale-100">
            <a href="/ads" class="underline text-purple-200">ad</a>
        </div>
    </div>
</div>
<script is:inline>
	// Toggles instead of only unhiding: the `april-fools` class is scoped to the
	// current page, so the ad must hide again when leaving a themed page.
	function syncAd() {
		var el = document.getElementById('april-ad');
		if (!el) return;
		el.classList.toggle('hidden', !document.documentElement.classList.contains('april-fools'));
	}
	syncAd();
	document.addEventListener('astro:page-load', syncAd);
</script>
