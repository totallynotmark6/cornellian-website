---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Advertisement from '../components/Advertisement.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Picture } from 'astro:assets';

type Props = CollectionEntry<'articles'>['data'];

const { title, author, description, pubDate, updatedDate, heroImage, heroImageCaption, heroImageCredit, minutesRead } = Astro.props;

const d = new Date(pubDate);
const isAprilFoolsArticle = d.getMonth() === 3 && d.getDate() === 1;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} aprilFools={isAprilFoolsArticle} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hidden print:inline">
					<h1 class="text-3xl">The Cornellian</h1>
				</div>

				<div>
					{heroImage && (
						<figure>
							<Picture src={heroImage} alt={heroImageCaption || ""} class="rounded-xl drop-shadow-sm aspect-video object-cover" loading="eager"/>
							{(heroImageCaption || heroImageCredit) && (
								<figcaption class="text-sm text-base-600 dark:text-base-500 mt-2 text-center italic">
									{heroImageCaption}
									{heroImageCaption && heroImageCredit && " | "}
									{heroImageCredit && <span class="font-semibold">Credit: {heroImageCredit}</span>}
								</figcaption>
							)}
						</figure>
					)}
				</div>
				<div>
					<div class="text-center print:text-left">
						<h1 class="text-2xl sm:text-4xl">{title}</h1>
						<h2 class="text-lg sm:text-2xl">{author}</h2>
						<div class="text-base text-base-600 dark:text-base-500">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="italic">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
							<p class="print:hidden">{minutesRead}</p>
						</div>
						<hr class="text-base-100 dark:text-base-900 my-4 sm:my-8" />
					</div>
					<Advertisement />
					<div class="prose dark:prose-invert prose-paper [&>p]:indent-8 text-justify prose-img:rounded-xl prose-figcaption:text-center">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
